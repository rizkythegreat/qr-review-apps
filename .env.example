# Origin permanen yang dicetak dalam QR. HTTPS wajib, tanpa trailing slash.
PUBLIC_ORIGIN=https://localhost:3000
# PostgreSQL Supabase (direct/session pooler, atau transaction pooler tanpa prepared statements).
DATABASE_URL=postgresql://postgres:password@localhost:5432/qr_review
# Migrations memakai akun pemilik schema; runtime dapat memakai akun server terpisah.
MIGRATION_DATABASE_URL=
DATABASE_SSL=false
# Gunakan true dan CA Supabase jika koneksi remote membutuhkan TLS.
DATABASE_SSL_CA=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Masing-masing 32 byte acak, base64. Buat dengan: openssl rand -base64 32
PIN_PEPPER=
HMAC_KEY=
ENCRYPTION_KEY=
# Header sumber IP yang DIHAPUS/DIGANTI proxy tepercaya; kosong = satu bucket bersama.
# Contoh Vercel: x-vercel-forwarded-for. Jangan percaya x-forwarded-for dari client.
TRUSTED_IP_HEADER=
# Opsional: header trafik uji deployment, HMAC value yang diberikan hanya ke load tester.
TEST_TRAFFIC_SECRET=
DATABASE_POOL_SIZE=5
STATISTICS_TIMEOUT_MS=150
